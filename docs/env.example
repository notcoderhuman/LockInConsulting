# LockIn Consulting — Environment Variable Template
#
# Note: NONE of these variables are required for the public development preview.
# The public homepage and all 11 destination pages run safely without a database
# connection, displaying verified static resources and an honest unverified status
# for university listings.
# The admin dashboard and auth APIs remain strictly fail-closed when configuration is absent.

# --- Public Site Configuration ---
# Public canonical origin for sitemap.xml and robots.txt.
# Leave unset in development to prevent search engine indexing.
# Format: https://example.com
NEXT_PUBLIC_SITE_URL=

# --- Database Configuration ---
# Main MySQL / MariaDB connection URI for university directory data.
# Optional for development preview; required for live database operations.
# Format: mysql://user:password@host:3306/database
DATABASE_URL=

# Optional override for admin operations requiring higher database privileges.
# If omitted, the admin pool falls back to DATABASE_URL.
# Format: mysql://admin_user:password@host:3306/database
ADMIN_DATABASE_URL=

# --- Staff Authentication & Admin Dashboard ---
# Secret key used by Better Auth to encrypt and sign session cookies.
# Required only when running the admin suite. Must be at least 32 characters.
BETTER_AUTH_SECRET=

# Canonical base URL for Better Auth redirects and trusted origin validation.
# Required when running the admin suite (e.g., http://localhost:3000 or https://admin.example.com).
# In production, this must use https://.
BETTER_AUTH_URL=

# Optional kill switch: set to "true" to immediately lock down and disable all admin access.
ADMIN_DISABLED=

# Optional: the single header your hosting proxy OVERWRITES with the client IP (e.g. x-real-ip).
# Leave unset until confirmed on the real host: then no IP is trusted and only per-account limits apply.
AUTH_CLIENT_IP_HEADER=

# --- Student support & Derek (all OFF by default; see RISKS.md R-026, R-027) ---
# Leave unset until the privacy/legal review is complete. There is no student sign-up either way.
STUDENT_ACCOUNTS_ENABLED=
# Live AI. DEREK_PROVIDER defaults to "mock" (offline; refused in production).
# "gemini" uses gemini-3.5-flash-lite, drafts only, and only for students with a recorded 18+ confirmation.
DEREK_AI_ENABLED=
DEREK_PROVIDER=
# SECRET. Server-side only: set in the hosting panel or your shell, never commit it or prefix it NEXT_PUBLIC_.
GEMINI_API_KEY=
# Optional; only gemini-3.5-flash-lite is accepted.
DEREK_GEMINI_MODEL=
# "true" only for a billing-enabled project. Required for Gemini in production (unpaid-tier prompts may be human-reviewed).
GEMINI_PAID_TIER=
# Cost cap: Gemini drafts per rolling 24 hours (default 100).
DEREK_GEMINI_DAILY_DRAFT_LIMIT=
# Provider attempts per draft: 1 or 2 (default 2). 1 = at most one request per draft.
DEREK_MAX_ATTEMPTS=
# Records that unreviewed automatic replies have been cleared (terms, privacy, age eligibility).
DEREK_AUTO_REPLY_CLEARED=
