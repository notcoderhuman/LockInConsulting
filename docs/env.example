# LockIn Consulting — Environment Variable Template
#
# Note: NONE of these variables are required for the public development preview.
# The public homepage and all 11 destination pages run safely without a database
# connection, displaying verified static resources and an honest unverified status
# for university listings.
# The admin dashboard and auth APIs remain strictly fail-closed when configuration is absent.

# --- Public Site Configuration ---
# Public canonical origin for sitemap.xml and robots.txt.
# Leave unset in development to prevent search engine indexing.
# Format: https://example.com
NEXT_PUBLIC_SITE_URL=

# --- Database Configuration ---
# Main MySQL / MariaDB connection URI for university directory data.
# Optional for development preview; required for live database operations.
# Format: mysql://user:password@host:3306/database
DATABASE_URL=

# Optional override for admin operations requiring higher database privileges.
# If omitted, the admin pool falls back to DATABASE_URL.
# Format: mysql://admin_user:password@host:3306/database
ADMIN_DATABASE_URL=

# --- Staff Authentication & Admin Dashboard ---
# Secret key used by Better Auth to encrypt and sign session cookies.
# Required only when running the admin suite. Must be at least 32 characters.
BETTER_AUTH_SECRET=

# Canonical base URL for Better Auth redirects and trusted origin validation.
# Required when running the admin suite (e.g., http://localhost:3000 or https://admin.example.com).
# In production, this must use https://.
BETTER_AUTH_URL=

# Optional kill switch: set to "true" to immediately lock down and disable all admin access.
ADMIN_DISABLED=

# Optional: the single header your hosting proxy OVERWRITES with the client IP (e.g. x-real-ip).
# Leave unset until confirmed on the real host: then no IP is trusted and only per-account limits apply.
AUTH_CLIENT_IP_HEADER=

# --- Student support & Derek (all OFF by default; see RISKS.md R-026, R-027) ---
# Leave unset until the privacy/legal review is complete.
STUDENT_ACCOUNTS_ENABLED=
# "true" (with STUDENT_ACCOUNTS_ENABLED) lets Google sign-in create NEW student accounts, each of which
# must still confirm 18+ and the privacy notice before using the chat. Unset: Google signs in existing
# Google-created students only. Keep unset until the reviewed privacy notice is published (R-026).
STUDENT_SELF_SIGNUP_ENABLED=
# Required in production before any new student account can open (https URL or /path).
STUDENT_PRIVACY_NOTICE_URL=
# Pre-launch tester mode: only these addresses (comma-separated) can use student accounts until the notice is ready.
STUDENT_TEST_EMAILS=
# Google OAuth for students (Google Cloud Console → APIs & Services → Credentials → OAuth client, type
# "Web application"). Authorised redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google, e.g.
# http://localhost:3000/api/auth/callback/google locally. Add the production one only once the real
# domain is known. SECRET: server-side only, never commit it or prefix it NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional student sign-in providers (docs/AUTH-PROVIDERS.md). Callback: <BETTER_AUTH_URL>/api/auth/callback/<provider>
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
# Outgoing mail for 6-digit sign-in and password-reset codes (docs/EMAIL-DELIVERY.md). Set the password in the
# hosting panel only. MAIL_TRANSPORT=log prints codes to the console instead (development only).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TRANSPORT=
# "true" shows the Hindi switch. Leave unset until docs/HINDI-REVIEW.md is approved: pages stay English.
HINDI_UI_ENABLED=
# Live AI. DEREK_PROVIDER defaults to "mock" (offline; refused in production).
# "gemini" uses gemini-3.5-flash-lite, drafts only, and only for students with a recorded 18+ confirmation.
DEREK_AI_ENABLED=
DEREK_PROVIDER=
# SECRET. Server-side only: set in the hosting panel or your shell, never commit it or prefix it NEXT_PUBLIC_.
GEMINI_API_KEY=
# Optional; only gemini-3.5-flash-lite is accepted.
DEREK_GEMINI_MODEL=
# Provider id whose OWN terms were reviewed and permit this student-facing service (Gemini: the
# "not for consumer use" and under-18 restrictions). Required in production before it may see real
# student messages. D-041 records Google's confirmation for Gemini: set it to gemini in production.
DEREK_PROVIDER_APPROVED=
# "true" only for a billing-enabled project. Required for Gemini in production (unpaid-tier prompts may be human-reviewed).
GEMINI_PAID_TIER=
# Cost cap: Gemini drafts per rolling 24 hours (default 100).
DEREK_GEMINI_DAILY_DRAFT_LIMIT=
# Provider attempts per draft: 1 or 2 (default 2). 1 = at most one request per draft.
DEREK_MAX_ATTEMPTS=
# Spend cap for every provider: input+output tokens per rolling 24 hours (default 500000).
DEREK_DAILY_TOKEN_LIMIT=
# The provider id (e.g. mock) whose review for unreviewed automatic replies is complete (terms,
# privacy, age eligibility). Clears only that provider (e.g. gemini, after the live smoke test; D-041).
DEREK_AUTO_REPLY_CLEARED=

# Run db/migrations once at server start, over 127.0.0.1, before serving (lib/db/boot-migrate.mjs).
# Set to 1 only for a deliberate first boot, then remove it. Failure stops the server.
MIGRATE_ON_BOOT=
