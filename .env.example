# Names only. Never commit real values. Set real values in Hostinger → Environment Variables.
# Without DATABASE_URL, public destination pages render "pending verification" and /admin fails closed.

# Public read-only / default MySQL connection string (used by public_* views, and as fallback for admin/auth)
DATABASE_URL=

# Optional separate MySQL credentials for least-privilege separation (R-014)
ADMIN_DATABASE_URL=
AUTH_DATABASE_URL=

# Stage 3: Better Auth (/admin staff authentication)
# Generate BETTER_AUTH_SECRET with: openssl rand -base64 32 (must be >= 32 characters)
BETTER_AUTH_SECRET=
# Public origin of the site (must be https:// in production, except localhost)
BETTER_AUTH_URL=

# Emergency kill switch: set to "true" to immediately disable /admin and /api/admin/*
ADMIN_DISABLED=false

# Optional target database URL for running `pnpm test:db` against a staging MySQL/MariaDB instance
# DB_TEST_URL=

# Phase 8: AI provider — intentionally unset. Blocked by RISKS.md R-001/R-002 and DECISIONS.md D-002.
# AI_PROVIDER=
